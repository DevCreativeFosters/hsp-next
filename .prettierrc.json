{
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "plugins": [ "@trivago/prettier-plugin-sort-imports" ],
    "importOrder": [
        "^react$",
        "^react-dom$",
        "^react-dom/(.*)$",
        "^next$",
        "<THIRD_PARTY_MODULES>",
        "@contexts",
        "@hooks",
        "@lib",
        "@components",
        "@assets",
        "@styles",
        "^../(.*)$",
        "^./(.*)$",
        "./(.*).module.scss",
        "(.*).module.scss"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}

{
    "compilerOptions": {
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@components/*": ["components/*"],
            "@styles/*": ["styles/*"],
            "@assets/*": ["assets/*"],
            "@images/*": ["assets/images/*"],
            "@lib/*": ["lib/*"],
            "@contexts/*": ["contexts/*"],
            "@hooks/*": ["hooks/*"],
            "@mockup/*": ["mockup/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    }
}
